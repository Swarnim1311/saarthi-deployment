# syntax=docker/dockerfile:1
# SAARTHI on Vercel (Fluid Compute / container deployment).
#
# Build context is website/Saarthi. No application changes are needed to
# deploy: this builds the existing Spring Boot jar (Java 17 bytecode, which
# runs on the Java 21 runtime — the same JDK family the project is developed
# and tested with) and runs it. The app listens on the platform-provided
# PORT (see server.port=${PORT:5000} in application.properties); locally
# PORT is unset so it keeps serving on 5000.
#
# No Maven wrapper exists in this project, so the build stage uses the
# official Maven image instead of ./mvnw.

FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN mvn -q -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/target/saarthi-backend-1.0.0.jar app.jar
# Documentary only: the runtime port comes from $PORT at container start.
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
