# SAARTHI environment configuration — TEMPLATE ONLY.
#
# Copy this file to `.env` in the project root and fill in real values.
# `.env` is listed in .gitignore and must NEVER be committed.
#
# This template must never contain a real key.

# Google Gemini API key for the Saarthi Agri-Advisor chatbot.
#
# When this is set, the chatbot logs "GEMINI MODE" at startup and answers using
# Gemini with live SAARTHI context. When it is absent it logs
# "LOCAL FALLBACK MODE" and answers from the repository's cited, offline crop
# reference instead. Both modes are fully functional; the key is never sent to
# the browser.
#
# Lookup order: GOOGLE_API_KEY env var, then ./.env, then ../.env, then ../../.env
GOOGLE_API_KEY=

# Bhashini voice credentials for the /api/voice server endpoints (ULCA portal:
# https://bhashini.gov.in/ulca/user/profile). TEMPLATE ONLY — never real values.
# Unset = voice endpoints stay fail-soft and the browser speech fallback is used.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Shared MeitY pipeline id (default when unset; override only if ULCA advises).
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Official mandi prices for CropAtlas (data.gov.in Agmarknet daily-price feed,
# Ministry of Agriculture & Farmers Welfare). TEMPLATE ONLY — never a real key.
#
# Unset = the market panel on every CropAtlas card shows "No recent verified
# market price available for this crop." No price is ever guessed or cached to
# disk. Set this to enable verified mandi prices (min / modal / max, with the
# record's own date, from the official feed only).
DATA_GOV_IN_API_KEY=

# Sign-in for /signin. DISABLED unless every value below is present, and no
# credential or password is ever stored in this file as plaintext: put a
# PBKDF2-SHA256 hash here, never the password itself.
#
# Generate a hash locally with:
#   mvn -q -DskipTests exec:java -Dexec.mainClass=com.saarthi.auth.PasswordHashTool
# (it reads the password from the console, so it never enters shell history).
SAARTHI_AUTH_ENABLED=false
SAARTHI_AUTH_FARMER_USERNAME=
SAARTHI_AUTH_FARMER_PASSWORD_HASH=
SAARTHI_AUTH_OFFICIAL_USERNAME=
SAARTHI_AUTH_OFFICIAL_PASSWORD_HASH=

